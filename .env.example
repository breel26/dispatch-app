# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dispatch_dev"

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Resend (vendor emails)
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend (SPF + DKIM
# records published under it) — a free-provider address like
# @gmail.com cannot be used and cannot be verified. For local testing
# only, onboarding@resend.dev works without a verified domain but will
# ONLY deliver to your own Resend account's email address.
DISPATCH_FROM_EMAIL=

# Where vendor replies go. Optional — defaults to DISPATCH_FROM_EMAIL.
# Unlike the sender, this has no domain restriction, so it can be any
# inbox the team actually reads (a Gmail account is fine here).
DISPATCH_REPLY_TO_EMAIL=
